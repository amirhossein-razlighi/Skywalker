      },
      "behaviors": [
        {
          "name": "Collectible",
          "intent": "Spin. When the player gets within 1 meter, announce it and disappear.",
          "source": "behavior Collectible\n  intent \"Spin. When the player gets within 1 meter, announce it and disappear.\"\n  on tick\n    rotate self by (0, 0, 180 * dt)\n    let p = nearest(\"player\")\n    if exists(p) and distance(self, p) < 1 then\n      emit \"coin_collected\"\n      log \"coin collected!\"\n      destroy self\n    end\n  end\nend\n",
