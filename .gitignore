# Build directories
build/
Build/
build-*/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json

# Temporary files
*.tmp
*.log
*.bak
*.swp

# vcpkg
vcpkg_installed/

# debug information files
*.dwo

# test output & cache
Testing/
.cache/

# Skywalker
.build/
.swiftpm/
DerivedData/
*.xcodeproj/
.DS_Store

# Downloaded third-party assets (re-fetched by the showcase builds; credits stay in CREDITS.md)
examples/*/downloads/

# Python bytecode
__pycache__/
*.pyc
# Downloaded sample models for manual animation checks (see docs/ANIMATION.md)
samples/

# Terrain caches (regenerated deterministically from each terrain generator)
examples/*/terrain/*.terrain
examples/*/terrain/*.r16

# Project caches (impostor atlases, native builds): rebuilt on demand
.skywalker/cache/
examples/*/studio/usage.json

# Neon Requiem: Blender-generated city kit (regenerated by media/demo/games/neon_requiem.py)
examples/neon_requiem/generated/
examples/neon_requiem/lookdev/

# Ashen Peaks: Blender-generated monastery kit (rebuilt by media/demo/games/ashen_peaks.py)
examples/ashen_peaks/dcc/
# Gloamwater art is painted by media/demo/games/gloamwater_art.py (regenerated on build)
examples/gloamwater/art/
examples/gloamwater/portraits/
examples/ashen_peaks/agents/
examples/ashen_peaks/studio/
examples/*/.skywalker/cache/
# Berrybrook: Blender farm kit and generated textures (rebuilt by media/demo/games/berrybrook.py); look-dev renders
examples/berrybrook/dcc/
examples/berrybrook/textures/
examples/berrybrook/lookdev/
